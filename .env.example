# Netris MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Netris controller address (hostname or IP, no protocol)
NETRIS_HOST=netris.example.com

# Required: Netris credentials
NETRIS_USERNAME=admin
NETRIS_PASSWORD=your-password-here

# Optional: Disable SSL verification for self-signed certs (default: true)
# NETRIS_SSL_VERIFY=false

# Optional: How often to ping the API to keep the session alive, in seconds (default: 1800)
# NETRIS_SESSION_REFRESH=1800

# Optional: HTTP request timeout in seconds (default: 30.0)
# NETRIS_TIMEOUT=30.0
